# Groundwater Drawdown Tool — optional environment overrides
#
# THIS FILE IS OPTIONAL. The tool runs fine without it.
#
# BCGW credentials are NOT in this file. Each user enters their BCGW
# username and password through the login screen when launching the tool.
# Credentials are never written to disk.
#
# Use this file only if you need to override a default. Copy to .env and
# edit; restart the tool for changes to take effect.

# --- Logging (optional) -------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR. Default: INFO
# LOG_LEVEL=INFO

# --- Output directory (optional) ----------------------------------------------
# Where exports (CSV, GeoJSON, PDF) are written before being served to the
# browser. Default: ./outputs
# OUTPUT_DIR=./outputs

# --- Dash debug mode (optional) -----------------------------------------------
# Set to true for hot-reload during development. Default: false.
# DASH_DEBUG=false

# --- Application defaults (CLIENT_TBD placeholders) ---------------------------

# Default pumping duration in days, used unless overridden in the UI.
# Default: 100 days (legacy Excel convention; deck slide 5).
# CLIENT_TBD: Q4, Q10 — confirm with Water Officer team.
# DEFAULT_PUMPING_DURATION_DAYS=100

# At-risk drawdown threshold as a fraction of SAD (Safe Available Drawdown).
# A well is flagged AT_RISK when (predicted drawdown / SAD) >= this fraction.
# Default: 0.30 (matches legacy Excel `Impact!V` and `InputValues!B30`).
# CLIENT_TBD: Q3 — confirm with hydrogeology team.
# AT_RISK_DRAWDOWN_FRACTION=0.30

# Cooper-Jacob validity threshold for u = r² × S / (4 × T × t).
# Standard literature value: 0.01.
# COOPER_JACOB_U_THRESHOLD=0.01

# --- Auto-update (Phase 6) ----------------------------------------------------
# Path to the network share where new tool releases are published.
# Read by update.bat (not by Python). Empty disables the update check.
# UPDATE_CHECK_SHARE=\\bcgov-share\teams\water-auth\groundwater-tool

# --- Session timeout (optional) -----------------------------------------------
# How long a logged-in session stays valid without activity. Default: 8 hours.
# SESSION_TIMEOUT_HOURS=8
